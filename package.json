{
  "name": "dsh-job-board",
  "version": "2.3.1",
  "description": "DSH 插件：把「团队 · 作业板」接进 DSH —— 作业板工具 + GUI 面板 + sh_* 命令工具，一个包装齐",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./shell": "./lib/shell.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "files": [
    "lib/",
    "cordis.patch.yml",
    "assets/pet.png",
    "assets/icon-180.png",
    "README.md",
    "CHANGELOG.md",
    "docs/review-response.md",
    "LICENSE",
    "tools/board_server.py",
    "scripts/install-board.ps1",
    "scripts/board-server-smoke.py",
    "scripts/config-persist-smoke.mjs",
    "scripts/dispatch-recovery-smoke.mjs",
    "scripts/fake-board.mjs",
    "scripts/set-team-config.ps1",
    "scripts/solo-board-smoke.mjs",
    "scripts/solo-bootstrap-smoke.mjs",
    "scripts/shell-guard-smoke.mjs",
    "scripts/ui-guard-smoke.mjs",
    "scripts/model-pick-smoke.mjs",
    "scripts/update-check-smoke.mjs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "board",
    "task-board",
    "multi-machine",
    "remote-agent",
    "shell",
    "team"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaot92-del/dsh-job-board.git"
  },
  "bugs": {
    "url": "https://github.com/shaot92-del/dsh-job-board/issues"
  },
