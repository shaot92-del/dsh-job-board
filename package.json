{
  "name": "dsh-team",
  "version": "1.0.1",
  "description": "DSH 插件：把「团队 · 作业板」接进 DSH —— 作业板工具 + GUI 面板 + sh_* 命令工具，一个包装齐",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./shell": "./lib/shell.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/shell.js",
    "cordis.patch.yml",
    "assets/pet.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "board",
    "task-board",
    "multi-machine",
    "remote-agent",
    "shell",
    "team"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaot92-del/dsh-team.git"
  },
  "bugs": {
    "url": "https://github.com/shaot92-del/dsh-team/issues"
  },
  "homepage": "https://github.com/shaot92-del/dsh-team#readme",
  "author": "往返长江 <348286458+shaot92-del@users.noreply.github.com>"
}
