+ * 于是写在**顶层**的 `maintenanceWriteEnabled` / `maintAuthPublicKeys` / `agentEnabled` /
+ * `allowlist` 等键在进入 worker 之前就被丢掉了 —— worker 只能用默认值（写通道 off、
+ * agent off、allowlist 空），远程写通道因此永远 `maint-write-disabled`，
+ * 而「开写通道」本身又只能走写通道 ⇒ 真机上出现死锁（GT14 2026-11-22）。
+ *
+ * 这里的规则：**子块优先，顶层兜底**，且只转发 worker 真正会读的键（避免把
+ * boardUrl/token 这类宿主键混进来造成歧义）。宿主的 apply 载荷改成
+ * `worker: mergeWorkerPayload(rowConfig)`，两种写法就都能生效，不再依赖缩进位置。
+ */
+export const WORKER_FORWARD_KEYS = Object.freeze([
+  // 执行 / shell
+  'execCwd',
+  'allowlist',
+  'allowedRoots',
+  'allowAllRoots',
+  'approvalMode',
+  'allowInline',
+  'shellTimeoutMs',
+  'maxOutputBytes',
+  'passEnv',
+  // agent
+  'agentEnabled',
+  'agentPreset',
+  'agentCwdRoot',
+  'agentAllowlist',
+  'agentPromptGate',
+  'agentTools',
+  'agentApproval',
+  'agentBudgetMaxPerDay',
+  'agentTimeoutMs',
+  'agentSourceKind',
+  // 维护通道
+  'maintenanceEnabled',
+  'maintenanceOutDir',
+  'maintenancePkgDir',
+  'maintenanceWriteEnabled',
+  'maintenanceAllowRestart',
+  'maintAuthPublicKeys',
+  'dshExePath',
+  'maintAuthKeyFile',
+  // 其它 worker 行为
+  'pollMs',
+  'beatMs',
+  'maxConcurrent',
+  'stateDir',
+  'logLimit',
+])
+
+export function mergeWorkerPayload(raw = {}) {
+  const flat = raw && typeof raw === 'object' && !Array.isArray(raw) ? raw : {}
+  const nested = flat.worker && typeof flat.worker === 'object' && !Array.isArray(flat.worker) ? flat.worker : {}
+  const merged = {}
+  for (const key of WORKER_FORWARD_KEYS) {
+    if (flat[key] !== undefined && flat[key] !== null) merged[key] = flat[key]
+  }
+  return { ...merged, ...nested }
+}
